import requests

# ⚙️ Cambia estas variables con tus datos reales
API_KEY = "TU_API_KEY_DE_OPEN_WEBUI"
API_URL = "http://localhost:3000/api/chat/completions"  # Reemplaza 'localhost' por la IP/Dominio de tu servidor
MODELO = "qwen3-coder:30b"


def probar_conexion():
    headers = {
        "Authorization": f"Bearer {API_KEY}",
        "Content-Type": "application/json",
    }

    payload = {
        "model": MODELO,
        "messages": [
            {
                "role": "user",
                "content": "Responde estrictamente con la palabra OK si recibes este mensaje.",
            }
        ],
        "stream": False,
    }

    try:
        print("Conectando con la API...")
        response = requests.post(
            API_URL, headers=headers, json=payload, timeout=10
        )

        response.raise_for_status()

        resultado = response.json()
        respuesta_texto = resultado["choices"][0]["message"]["content"]

        print("✅ CONEXIÓN EXITOSA")
        print("Respuesta del modelo:", respuesta_texto)

    except requests.exceptions.ConnectionError:
        print(
            "❌ ERROR DE CONEXIÓN: No se pudo alcanzar la dirección IP/puerto."
        )
    except requests.exceptions.HTTPError as err:
        print(f"❌ ERROR HTTP {response.status_code}: {response.text}")
    except Exception as e:
        print(f"❌ ERROR INESPERADO: {e}")


if __name__ == "__main__":
    probar_conexion()